# Supabase Configuration
# Copia este archivo a .env.local y completa con tus credenciales

# URL del proyecto Supabase (obtenlo de Supabase Dashboard > Settings > API)
# Formato: https://PROJECT_ID.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon Key (pública, segura de exponer en cliente)
# Obtenlo de Supabase Dashboard > Settings > API > Project API keys > anon key
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Contraseña de la base de datos (para backups)
# Obtenlo de Supabase Dashboard > Settings > Database > Password
# IMPORTANTE: No commits este archivo a Git
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
